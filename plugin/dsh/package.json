{
  "name": "@carloswon/cairn-dsh-memory",
  "version": "0.4.2",
  "type": "module",
  "description": "Cairn memory for DeepSeek Harness: real-time recall, backed by the Cairn MCP server as its core",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json",
    "./client": "./src/client.js"
  },
  "files": [
    "dist",
    "src/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsx --test tests/*.test.ts"
  },
  "license": "MIT",
  "publishConfig": { "access": "public" },
  "keywords": ["dsh", "dsh-plugin", "memory", "cairn", "agent-memory", "local-first"],
  "repository": { "type": "git", "url": "git+https://github.com/CarlosWonMore/cairn.git", "directory": "plugin/dsh" },
  "homepage": "https://github.com/CarlosWonMore/cairn/tree/main/plugin/dsh"
}