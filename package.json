{
  "name": "@cairn/memory",
  "version": "0.1.0",
  "description": "Cairn — 个人、多设备、多 Agent 的本地优先记忆主权层（local-first memory sovereignty layer）",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "cairn": "dist/src/interfaces/cli/main.js",
    "cairn-mcp": "dist/src/interfaces/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./core": "./dist/src/core/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/",
    "test:module": "node --import tsx --test",
    "smoke:pack": "npm run build && npm pack --dry-run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "private": true
}
