{
  "name": "@cairn/memory",
  "version": "0.2.0",
  "description": "Cairn — 个人、多设备、多 Agent 的本地优先记忆主权层。本地 SQLite 为权威副本，云端仅作可选加密中继。",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "cairn": "dist/src/interfaces/cli/main.js",
    "cairn-mcp": "dist/src/interfaces/mcp/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "docs/cairn-usage.md",
    "docs/cairn-security.md"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./core": "./dist/src/core/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "cli": "tsx src/interfaces/cli/main.ts",
    "mcp": "tsx src/interfaces/mcp/server.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && tsx --test --test-concurrency=2 \"tests/**/*.test.ts\"",
    "test:module": "node --import tsx --test",
    "test:real": "node scripts/test-real-obs.mjs",
    "mcp:smoke": "npm run build && node scripts/mcp-smoke.mjs",
    "smoke:pack": "npm run build && npm pack --dry-run",
    "test:e2e": "npm run build && node scripts/e2e-onboarding.mjs",
    "test:ui": "npm run build && node scripts/e2e-console-ui.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.20.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/hashes": "^2.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  },
  "private": true,
  "keywords": [
    "memory",
    "agent-memory",
    "mcp",
    "model-context-protocol",
    "local-first",
    "sqlite",
    "ai-agents",
    "memory-sovereignty",
    "fts5",
    "cli"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CarlosWonMore/cairn.git"
  },
  "homepage": "https://github.com/CarlosWonMore/cairn#readme",
  "bugs": {
    "url": "https://github.com/CarlosWonMore/cairn/issues"
  },
  "author": "Carlos",
  "publishConfig": {
    "access": "public"
  }
}
